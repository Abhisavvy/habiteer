# Client (safe to expose — protected by Row-Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google OAuth (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Server only — for Drizzle migrations. NEVER ship in the app bundle.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Server only — persistent account for src/lib/db/__tests__ integration tests.
TEST_USER_EMAIL=habiteer.rpctest@example.com
TEST_USER_PASSWORD=CHANGE_ME
